# Public site URL (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload — generate a long random string (e.g. openssl rand -hex 32)
PAYLOAD_SECRET=

# Seeded super admin password (used once on first boot)
SEED_SUPER_ADMIN_PASSWORD=

# Neon / Vercel Postgres connection string
# Prefer POSTGRES_URL from the Vercel Neon integration.
POSTGRES_URL=
# Fallback alias some tools use:
# DATABASE_URL=
